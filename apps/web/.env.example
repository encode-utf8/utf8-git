# ===== utf8-git Web 环境变量（复制为 .env 后填写，.env 不入库） =====

# 1) 数据库连接（与仓库根 docker-compose.dev.yml 的默认值一致）
DATABASE_URL="postgresql://utf8git:utf8git_dev@localhost:5432/utf8git?schema=public"

# 2) Auth.js 会话签名密钥（必填）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 3) GitHub 令牌加密密钥（必填，32 字节 base64，AES-256-GCM）
# 生成方式同上，且必须与 AUTH_SECRET 使用不同的随机值
AUTH_TOKEN_ENC_KEY=""

# 4) GitHub OAuth App 凭据（本地联调必填；平台上线后由平台统一提供，最终用户无需配置）
# 创建入口：https://github.com/settings/developers
# 回调地址：http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
