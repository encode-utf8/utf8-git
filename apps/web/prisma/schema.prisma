// utf8-git 认证数据模型（Auth.js 约定 + 令牌密文存储约定）
// 迁移命令：pnpm --filter @utf8-git/web exec prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 共享 TTL 缓存（M1-6）：多实例 / Serverless 部署下让缓存跨实例生效。
// 仅在 STORE_BACKEND=postgres 时启用，内存后端不写这张表。
model SharedCacheEntry {
  key       String   @id
  scope     String // 缓存类别（repos / timeline / cursor / commit），便于按类排查与清理
  value     Json
  storedAt  BigInt   @map("stored_at") // unix 毫秒（与内存实现一致）
  expiresAt DateTime @map("expires_at") // 绝对过期时间，用于清理过期条目

  @@map("shared_cache_entries")
}

// 共享限流快照（M1-6）：每用户一行，跨实例共享 GitHub 配额状态，避免各实例判定不一致。
model RateLimitState {
  userId     String    @id @map("user_id")
  limitValue Int?      @map("limit_value")
  remaining  Int
  resetAt    DateTime? @map("reset_at")
  cost       Int?
  source     String
  recordedAt BigInt    @map("recorded_at")

  @@map("rate_limit_states")
}

// 用户：以 GitHub 账号为唯一身份来源
model User {
  id            String    @id // 使用 OAuth profile 的 id（GitHub 数字 ID）作为主键
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  githubLogin   String?   @unique @map("github_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

// OAuth 账号关联：access / refresh / id token 仅存密文，明文不落库
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  accessTokenEnc    String? @map("access_token_enc")
  refreshTokenEnc   String? @map("refresh_token_enc")
  idTokenEnc        String? @map("id_token_enc")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// 数据库会话：浏览器 Cookie 中只保存随机会话令牌
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Auth.js 约定的邮箱验证令牌表（当前仅 GitHub 登录，保留以符合适配器契约）
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
